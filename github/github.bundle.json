{
  "auth_references": [
    {
      "auth_mode": "static_bearer",
      "key": "github_default_token",
      "name": "GitHub API Token",
      "public_config_json": {},
      "secret_backend": "environment",
      "secret_bindings_json": {
        "token": "GITHUB_API_TOKEN"
      },
      "status": "active"
    }
  ],
  "connector": {
    "base_url": "https://api.github.com",
    "config_json": {
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2026-03-10"
      },
      "provider_key": "github"
    },
    "default_auth_key": "github_default_token",
    "description": "Read-only GitHub connector for repository inventory, repository visibility policy review, organization-wide two-factor authentication enforcement review, and organization-member MFA review.",
    "family": "custom_api",
    "name": "GitHub Connector",
    "status": "active"
  },
  "package_key": "github",
  "package_type": "connector_bundle",
  "release": "2026.09.4",
  "schema_version": "connector_bundle.v1",
  "workflows": [
    {
      "definition_json": {
        "connector": {
          "config_id": "",
          "family": ""
        },
        "steps": [
          {
            "auth_reference_id": "__use_default__",
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "field_allowlist": [
                "id",
                "name",
                "full_name",
                "owner_login",
                "private",
                "visibility",
                "archived",
                "disabled",
                "topics",
                "updated_at"
              ],
              "field_mappings": [
                {
                  "output_field": "owner_login",
                  "source_path": "owner.login"
                }
              ],
              "mode": "records_contract_v1"
            },
            "output_alias": "get_1",
            "pagination": {
              "continuation": {
                "enabled": true,
                "max_partitions": 20
              },
              "max_pages": 1,
              "mode": "page_number",
              "page_param": "page",
              "start_page": 1
            },
            "request": {
              "path": "/user/repos",
              "query_params": {
                "affiliation": "owner,collaborator,organization_member",
                "direction": "asc",
                "per_page": 50,
                "sort": "full_name",
                "visibility": "all"
              }
            },
            "response_handling": {
              "records_path": "$"
            },
            "step_key": "get_1",
            "step_type": "connector_get"
          },
          {
            "input_source": "get_1.records",
            "match_policy": "all",
            "output_alias": "filter_1",
            "rules": [
              {
                "field": "topics",
                "operator": "contains",
                "value": "expected-private"
              },
              {
                "field": "visibility",
                "operator": "not_equals",
                "value": "private"
              }
            ],
            "step_key": "filter_1",
            "step_type": "filter_rule"
          },
          {
            "mapping": {
              "additional_information_template": "GitHub repository {{ record.full_name }} is marked with the public policy topic expected-private but currently reports visibility {{ record.visibility|default:'not returned' }}. Confirm whether the visibility changed accidentally and restrict access in GitHub when required. Repository ID: {{ record.id }}. Owner: {{ record.owner_login|default:'not returned' }}. Archived: {% if record.archived == None or record.archived == '' %}not returned{% else %}{{ record.archived }}{% endif %}. Disabled: {% if record.disabled == None or record.disabled == '' %}not returned{% else %}{{ record.disabled }}{% endif %}. Last updated: {{ record.updated_at|default:'not returned' }}.",
              "owner_user_id": "",
              "task_title_template": "Review GitHub repository visibility for {{ record.full_name }}"
            },
            "record_source": "filter_1.records",
            "step_key": "route_1",
            "step_type": "destination_task_create"
          }
        ],
        "trigger": {
          "mode": "manual"
        }
      },
      "description": "Creates tasks when a repository marked with the expected-private topic is not currently private.",
      "key": "expected_private_repository_exposure_review",
      "name": "GitHub Expected Private Repository Exposure Review",
      "status": "active"
    },
    {
      "definition_json": {
        "connector": {
          "config_id": "",
          "family": ""
        },
        "steps": [
          {
            "auth_reference_id": "__use_default__",
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "field_allowlist": [
                "id",
                "login"
              ],
              "field_coercions": [
                {
                  "coerce_to": "integer",
                  "field": "id"
                }
              ],
              "field_mappings": [
                {
                  "output_field": "id",
                  "source_path": "id"
                },
                {
                  "output_field": "login",
                  "source_path": "login"
                }
              ],
              "mode": "records_contract_v1"
            },
            "output_alias": "get_1",
            "pagination": {
              "continuation": {
                "enabled": true,
                "max_partitions": 20
              },
              "max_pages": 1,
              "mode": "page_number",
              "page_param": "page",
              "start_page": 1
            },
            "request": {
              "path": "/orgs/REPLACE_WITH_GITHUB_ORGANIZATION/members",
              "query_params": {
                "filter": "2fa_disabled",
                "per_page": 100,
                "role": "all"
              }
            },
            "response_handling": {
              "records_path": "$"
            },
            "step_key": "get_1",
            "step_type": "connector_get"
          },
          {
            "mapping": {
              "control_test_alias": "github_member_mfa",
              "control_test_code": "T-60",
              "control_test_id": "00000000-0000-0000-0000-000000000000",
              "data_source_label": "GitHub member MFA review",
              "evaluation_mode": "fail_when_records_present",
              "notes": "Reviews multi-factor authentication enrollment for direct members of the selected GitHub organization. Confirm organization-owner access and the intended membership scope before enabling this workflow. A complete collection passes when no members without multi-factor authentication are found and fails when such members are found. Incomplete collection is inconclusive; collection or data-processing failures are errors. This does not assess policy enforcement, authentication method strength, outside collaborators, or identities outside the selected organization."
            },
            "record_source": "get_1.records",
            "step_key": "route_1",
            "step_type": "destination_control_test_result_add"
          },
          {
            "mapping": {
              "additional_information_template": "GitHub returned organization member {{ record.login }} (user ID {{ record.id }}) from the organization-owner-only 2fa_disabled member filter. Confirm the account still requires organization access, then require the user to enable an approved MFA method in GitHub.",
              "owner_user_id": "",
              "task_title_template": "Enable MFA for GitHub user {{ record.login }}"
            },
            "record_source": "get_1.records",
            "step_key": "route_2",
            "step_type": "destination_task_create"
          }
        ],
        "trigger": {
          "mode": "manual"
        }
      },
      "description": "Adds a Control Test Result and creates tasks for GitHub organization members returned by GitHub's two-factor-authentication-disabled filter.",
      "key": "organization_members_without_mfa_review",
      "name": "GitHub Organization Members Without MFA Review",
      "status": "draft"
    },
    {
