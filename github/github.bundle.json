{
  "auth_references": [
    {
      "auth_mode": "static_bearer",
      "key": "github_default_token",
      "name": "GitHub API Token",
      "public_config_json": {},
      "secret_backend": "environment",
      "secret_bindings_json": {
        "token": "GITHUB_API_TOKEN"
      },
      "status": "active"
    }
  ],
  "connector": {
    "base_url": "https://api.github.com",
    "config_json": {
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2026-03-10"
      },
      "provider_key": "github"
    },
    "default_auth_key": "github_default_token",
    "description": "Read-only GitHub connector for repository inventory, repository visibility policy review, organization-wide two-factor authentication enforcement review, and organization-member MFA review.",
    "family": "custom_api",
    "name": "GitHub Connector",
    "status": "active"
  },
  "package_type": "connector_bundle",
  "schema_version": "connector_bundle.v1",
  "workflows": [
    {
      "definition_json": {
        "connector": {
          "config_id": "",
          "family": ""
        },
        "steps": [
          {
            "auth_reference_id": "__use_default__",
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "field_allowlist": [
                "id",
                "name",
                "full_name",
                "owner_login",
                "private",
                "visibility",
                "archived",
                "disabled",
                "topics",
                "updated_at"
              ],
              "field_mappings": [
                {
                  "output_field": "owner_login",
                  "source_path": "owner.login"
                }
              ],
              "mode": "records_contract_v1"
            },
            "output_alias": "get_1",
            "pagination": {
              "continuation": {
                "enabled": true,
                "max_partitions": 20
              },
              "max_pages": 1,
              "mode": "page_number",
              "page_param": "page",
              "start_page": 1
            },
            "request": {
              "path": "/user/repos",
              "query_params": {
                "affiliation": "owner,collaborator,organization_member",
                "direction": "asc",
                "per_page": 50,
                "sort": "full_name",
                "visibility": "all"
              }
            },
            "response_handling": {
              "records_path": "$"
            },
            "step_key": "get_1",
            "step_type": "connector_get"
          },
          {
            "input_source": "get_1.records",
            "match_policy": "all",
            "output_alias": "filter_1",
            "rules": [
              {
                "field": "topics",
                "operator": "contains",
                "value": "tenarie-private"
              },
              {
                "field": "visibility",
                "operator": "not_equals",
                "value": "private"
              }
            ],
            "step_key": "filter_1",
            "step_type": "filter_rule"
          },
          {
            "mapping": {
              "additional_information_template": "GitHub repository {{ record.full_name }} is marked with the public policy topic tenarie-private but currently reports visibility {{ record.visibility|default:'not returned' }}. Confirm whether the visibility changed accidentally and restrict access in GitHub when required. Repository ID: {{ record.id }}. Owner: {{ record.owner_login|default:'not returned' }}. Archived: {{ record.archived|default:'not returned' }}. Disabled: {{ record.disabled|default:'not returned' }}. Last updated: {{ record.updated_at|default:'not returned' }}.",
              "owner_user_id": "",
              "task_title_template": "Review GitHub repository visibility for {{ record.full_name }}"
            },
            "record_source": "filter_1.records",
            "step_key": "route_1",
            "step_type": "destination_task_create"
          }
        ],
        "trigger": {
          "mode": "manual"
        }
      },
      "description": "Creates tasks when a repository marked with the tenarie-private topic is not currently private.",
      "name": "GitHub Expected Private Repository Exposure Review",
      "status": "active"
    },
    {
      "definition_json": {
        "connector": {
          "config_id": "",
          "family": ""
        },
        "steps": [
          {
            "auth_reference_id": "__use_default__",
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "field_allowlist": [
                "id",
                "login"
              ],
              "mode": "records_contract_v1"
            },
            "output_alias": "get_1",
            "pagination": {
              "continuation": {
                "enabled": true,
                "max_partitions": 20
              },
              "max_pages": 1,
              "mode": "page_number",
              "page_param": "page",
              "start_page": 1
            },
            "request": {
              "path": "/orgs/REPLACE_WITH_GITHUB_ORGANIZATION/members",
              "query_params": {
                "filter": "2fa_disabled",
                "per_page": 100,
                "role": "all"
              }
            },
            "response_handling": {
              "records_path": "$"
            },
            "step_key": "get_1",
            "step_type": "connector_get"
          },
          {
            "mapping": {
              "control_test_alias": "github_member_mfa",
              "control_test_code": "CONFIGURE_AFTER_IMPORT",
              "control_test_id": "00000000-0000-0000-0000-000000000000",
              "data_source_label": "GitHub member MFA review",
              "evaluation_mode": "fail_when_records_present",
              "notes": "Complete GitHub collection passes when the organization-owner-only 2fa_disabled member filter returns no direct organization members. Returned members fail the result. Incomplete collection is inconclusive and provider failure is recorded as error."
            },
            "record_source": "get_1.records",
            "step_key": "route_1",
            "step_type": "destination_control_test_result_add"
          },
          {
            "mapping": {
              "additional_information_template": "GitHub returned organization member {{ record.login }} (user ID {{ record.id }}) from the organization-owner-only 2fa_disabled member filter. Confirm the account still requires organization access, then require the user to enable an approved MFA method in GitHub.",
              "owner_user_id": "",
              "task_title_template": "Enable MFA for GitHub user {{ record.login }}"
            },
            "record_source": "get_1.records",
            "step_key": "route_2",
            "step_type": "destination_task_create"
          }
        ],
        "trigger": {
          "mode": "manual"
        }
      },
      "description": "Adds a Control Test Result and creates tasks for GitHub organization members returned by GitHub's two-factor-authentication-disabled filter.",
      "name": "GitHub Organization Members Without MFA Review",
      "status": "draft"
    },
    {
      "definition_json": {
        "connector": {
          "config_id": "",
          "family": ""
        },
        "steps": [
          {
            "auth_reference_id": "__use_default__",
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "field_allowlist": [
                "id",
                "login",
                "two_factor_requirement_enabled"
              ],
              "mode": "records_contract_v1"
            },
            "output_alias": "get_1",
            "request": {
              "path": "/orgs/REPLACE_WITH_GITHUB_ORGANIZATION",
              "query_params": {}
            },
            "response_handling": {
              "records_path": "$"
            },
            "step_key": "get_1",
            "step_type": "connector_get"
          },
          {
            "input_source": "get_1.records",
            "match_policy": "all",
            "output_alias": "filter_1",
            "rules": [
              {
                "field": "two_factor_requirement_enabled",
                "operator": "not_equals",
                "value": true
              }
            ],
            "step_key": "filter_1",
            "step_type": "filter_rule"
          },
          {
            "mapping": {
              "additional_information_template": "GitHub organization {{ record.login|default:'not returned' }} (organization ID {{ record.id|default:'not returned' }}) did not report two-factor authentication enforcement as enabled. Reported value: {{ record.two_factor_requirement_enabled|default:'not returned' }}. Confirm the request used an organization-owner token with access to full organization details, then enable an approved two-factor authentication requirement in GitHub.",
              "owner_user_id": "",
              "task_title_template": "Enable two-factor authentication enforcement for GitHub organization {{ record.login|default:'organization' }}"
            },
            "record_source": "filter_1.records",
            "step_key": "route_1",
            "step_type": "destination_task_create"
          }
        ],
        "trigger": {
          "mode": "manual"
        }
      },
      "description": "Creates a task when GitHub does not report organization-wide two-factor authentication enforcement as enabled.",
      "name": "GitHub Organization Two-Factor Authentication Enforcement Review",
      "status": "draft"
    },
    {
      "definition_json": {
        "connector": {
          "config_id": "",
          "family": ""
        },
        "steps": [
          {
            "auth_reference_id": "__use_default__",
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "field_allowlist": [
                "id",
                "name",
                "full_name",
                "owner_login",
                "private",
                "visibility",
                "default_branch",
                "archived",
                "disabled",
                "fork",
                "topics",
                "pushed_at",
                "updated_at"
              ],
              "field_mappings": [
                {
                  "output_field": "owner_login",
                  "source_path": "owner.login"
                }
              ],
              "mode": "records_contract_v1"
            },
            "output_alias": "get_1",
            "pagination": {
              "continuation": {
                "enabled": true,
                "max_partitions": 20
              },
              "max_pages": 1,
              "mode": "page_number",
              "page_param": "page",
              "start_page": 1
            },
            "request": {
              "path": "/user/repos",
              "query_params": {
                "affiliation": "owner,collaborator,organization_member",
                "direction": "asc",
                "per_page": 50,
                "sort": "full_name",
                "visibility": "all"
              }
            },
            "response_handling": {
              "records_path": "$"
            },
            "step_key": "get_1",
            "step_type": "connector_get"
          },
          {
            "mapping": {
              "asset_type": "application",
              "description_template": "GitHub repository {{ record.full_name }} with current visibility {{ record.visibility|default:'not returned' }}.",
              "external_id_template": "{{ record.id }}",
              "external_system": "github",
              "notes_template": "Owner: {{ record.owner_login|default:'not returned' }}. Default branch: {{ record.default_branch|default:'not returned' }}. Private: {{ record.private|default:'not returned' }}. Archived: {{ record.archived|default:'not returned' }}. Disabled: {{ record.disabled|default:'not returned' }}. Fork: {{ record.fork|default:'not returned' }}. Topics: {{ record.topics|default:'none returned' }}. Last push: {{ record.pushed_at|default:'not returned' }}. Last updated: {{ record.updated_at|default:'not returned' }}.",
              "owner_user_id": "",
              "title_template": "GitHub Repository {{ record.full_name }}"
            },
            "record_source": "get_1.records",
            "step_key": "route_1",
            "step_type": "destination_asset_create"
          }
        ],
        "trigger": {
          "mode": "manual"
        }
      },
      "description": "Creates or reuses one Tenarie Asset for each GitHub repository available to the connected token and reports its current visibility.",
      "name": "GitHub Repository Inventory",
      "status": "active"
    }
  ]
}
