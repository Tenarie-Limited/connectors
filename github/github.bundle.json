          },
          {
            "input_source": "get_1.records",
            "match_policy": "all",
            "output_alias": "filter_1",
            "rules": [
              {
                "field": "two_factor_requirement_enabled",
                "operator": "not_equals",
                "value": true
              }
            ],
            "step_key": "filter_1",
            "step_type": "filter_rule"
          },
          {
            "mapping": {
              "control_test_alias": "organization_mfa_enforcement_result",
              "control_test_code": "T-61",
              "control_test_id": "00000000-0000-0000-0000-000000000000",
              "data_source_label": "GitHub Organization MFA Enforcement Result",
              "evaluation_mode": "fail_when_records_present",
              "notes": "Confirm the intended organization and permission to read its authentication policy before enabling this workflow. Keep this workflow in draft until missing policy information can be distinguished from a compliant policy. An empty response does not establish that multi-factor authentication is required."
            },
            "record_source": "filter_1.records",
            "step_key": "result_1",
            "step_type": "destination_control_test_result_add"
          }
        ],
        "trigger": {
          "mode": "manual"
        }
      },
      "description": "Reviews whether the selected GitHub organization requires multi-factor authentication for its members.",
      "key": "organization_mfa_enforcement_result",
      "name": "GitHub Organization MFA Enforcement Result",
      "status": "draft"
    },
