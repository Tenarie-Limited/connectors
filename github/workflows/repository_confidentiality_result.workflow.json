{
  "name": "GitHub Repository Confidentiality Result",
  "description": "Reviews repository visibility to help identify repositories that may conflict with your organization's confidentiality requirements. Confirm which repositories must remain private before enabling this workflow.",
  "status": "draft",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/user/repos",
          "query_params": {
            "visibility": "all",
            "affiliation": "owner,collaborator,organization_member",
            "sort": "full_name",
            "direction": "asc",
            "per_page": 50
          }
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "pagination": {
          "mode": "page_number",
          "page_param": "page",
          "start_page": 1,
          "max_pages": 1,
          "continuation": {
            "enabled": true,
            "max_partitions": 20
          }
        },
        "response_handling": {
          "records_path": "$"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_mappings": [
            {
              "output_field": "id",
              "source_path": "id"
            },
            {
              "output_field": "topics",
              "source_path": "topics"
            },
            {
              "output_field": "visibility",
              "source_path": "visibility"
            }
          ],
          "field_coercions": [
            {
              "field": "id",
              "coerce_to": "integer"
            }
          ],
          "field_allowlist": [
            "id",
            "topics",
            "visibility"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "filter_1",
        "step_type": "filter_rule",
        "input_source": "get_1.records",
        "output_alias": "filter_1",
        "match_policy": "all",
        "rules": [
          {
            "field": "topics",
            "operator": "contains",
            "value": "expected-private"
          },
          {
            "field": "visibility",
            "operator": "not_equals",
            "value": "private"
          }
        ]
      },
      {
        "step_key": "result_1",
        "step_type": "destination_control_test_result_add",
        "record_source": "filter_1.records",
        "mapping": {
          "control_test_alias": "repository_confidentiality_result",
          "control_test_id": "00000000-0000-0000-0000-000000000000",
          "control_test_code": "T-62",
          "evaluation_mode": "fail_when_records_present",
          "data_source_label": "GitHub Repository Confidentiality Result",
          "notes": "Keep this workflow in draft until the repositories that must remain private are identified and their visibility can be confirmed. Missing repositories, an empty selection, or unknown visibility do not establish compliance with confidentiality requirements."
        }
      }
    ]
  }
}
