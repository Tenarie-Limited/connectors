{
  "name": "Cloudflare Zone Status Review",
  "description": "Creates tasks for Cloudflare zones that are paused or are not reported as active.",
  "status": "active",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/client/v4/zones",
          "query_params": {
            "per_page": 50
          }
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "pagination": {
          "mode": "page_number",
          "page_param": "page",
          "start_page": 1,
          "max_pages": 1,
          "continuation": {
            "enabled": true,
            "max_partitions": 20
          }
        },
        "response_handling": {
          "records_path": "result"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_allowlist": [
            "id",
            "name",
            "status",
            "paused",
            "type",
            "modified_on"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "filter_1",
        "step_type": "filter_rule",
        "input_source": "get_1.records",
        "output_alias": "filter_1",
        "match_policy": "any",
        "rules": [
          {
            "field": "paused",
            "operator": "equals",
            "value": true
          },
          {
            "field": "status",
            "operator": "not_equals",
            "value": "active"
          }
        ]
      },
      {
        "step_key": "route_1",
        "step_type": "destination_task_create",
        "record_source": "filter_1.records",
        "mapping": {
          "task_title_template": "Review Cloudflare zone status for {{ record.name }}",
          "additional_information_template": "Cloudflare zone {{ record.name }} ({{ record.id }}) requires review. Provider status: {{ record.status|default:'not returned' }}. Paused: {% if record.paused == None or record.paused == '' %}not returned{% else %}{{ record.paused }}{% endif %}. Zone type: {{ record.type|default:'not returned' }}. Confirm that the current zone state is intended and restore normal service where appropriate.",
          "owner_user_id": ""
        }
      }
    ]
  }
}
