{
  "name": "Cloudflare DNSSEC Status Review",
  "description": "Creates tasks for Cloudflare zones whose DNSSEC status is not active while excluding DS records and key material from worker output.",
  "status": "active",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/client/v4/zones",
          "query_params": {
            "per_page": 50
          }
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "pagination": {
          "mode": "page_number",
          "page_param": "page",
          "start_page": 1,
          "max_pages": 1,
          "continuation": {
            "enabled": true,
            "max_partitions": 20
          }
        },
        "response_handling": {
          "records_path": "result"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_allowlist": [
            "id",
            "name"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "get_2",
        "step_type": "connector_get",
        "request": {
          "path": "/client/v4/zones/{{ record.id }}/dnssec",
          "query_params": {}
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "iteration": {
          "mode": "for_each_record",
          "records_source": "get_1.records",
          "preserved_parent_fields": [
            "id",
            "name"
          ]
        },
        "response_handling": {
          "records_path": "result"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_allowlist": [
            "status",
            "modified_on"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_2"
      },
      {
        "step_key": "filter_1",
        "step_type": "filter_rule",
        "input_source": "get_2.records",
        "output_alias": "filter_1",
        "match_policy": "all",
        "rules": [
          {
            "field": "status",
            "operator": "not_equals",
            "value": "active"
          }
        ]
      },
      {
        "step_key": "route_1",
        "step_type": "destination_task_create",
        "record_source": "filter_1.records",
        "mapping": {
          "task_title_template": "Review DNSSEC for Cloudflare zone {{ record.parent_context.name }}",
          "additional_information_template": "Cloudflare reports DNSSEC status {{ record.status|default:'not returned' }} for zone {{ record.parent_context.name }} ({{ record.parent_context.id }}). Review the zone and registrar configuration before enabling or repairing DNSSEC. Last modified: {{ record.modified_on|default:'not returned' }}.",
          "owner_user_id": ""
        }
      }
    ]
  }
}
