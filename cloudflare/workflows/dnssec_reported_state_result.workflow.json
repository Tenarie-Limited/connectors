{
  "name": "Cloudflare DNSSEC Reported State Result",
  "description": "Reviews the DNSSEC status reported by Cloudflare for the selected zones.",
  "status": "draft",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/client/v4/zones",
          "query_params": {
            "per_page": 50
          }
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "pagination": {
          "mode": "page_number",
          "page_param": "page",
          "start_page": 1,
          "max_pages": 1,
          "continuation": {
            "enabled": true,
            "max_partitions": 20
          }
        },
        "response_handling": {
          "records_path": "result"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_allowlist": [
            "id",
            "name"
          ],
          "field_mappings": [
            {
              "output_field": "id",
              "source_path": "id"
            }
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "get_2",
        "step_type": "connector_get",
        "request": {
          "path": "/client/v4/zones/{{ record.id }}/dnssec",
          "query_params": {}
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "iteration": {
          "mode": "for_each_record",
          "records_source": "get_1.records",
          "preserved_parent_fields": [
            "id",
            "name"
          ]
        },
        "response_handling": {
          "records_path": "result"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_mappings": [
            {
              "output_field": "status",
              "source_path": "status"
            }
          ],
          "field_allowlist": [
            "status"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_2"
      },
      {
        "step_key": "filter_1",
        "step_type": "filter_rule",
        "input_source": "get_2.records",
        "output_alias": "filter_1",
        "match_policy": "all",
        "rules": [
          {
            "field": "status",
            "operator": "not_equals",
            "value": "active"
          }
        ]
      },
      {
        "step_key": "result_1",
        "step_type": "destination_control_test_result_add",
        "record_source": "filter_1.records",
        "mapping": {
          "control_test_alias": "dnssec_reported_state_result",
          "control_test_id": "00000000-0000-0000-0000-000000000000",
          "control_test_code": "T-64",
          "evaluation_mode": "fail_when_records_present",
          "data_source_label": "Cloudflare DNSSEC Reported State Result",
          "notes": "Confirm which zones are included before enabling this workflow. Keep it in draft until missing zones and unknown DNSSEC status can be handled reliably. Reported DNSSEC status does not independently verify the DNS chain of trust."
        }
      }
    ]
  }
}
