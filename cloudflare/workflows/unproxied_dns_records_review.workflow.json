{
  "name": "Cloudflare Unproxied Public DNS Records Review",
  "description": "Creates advisory tasks for proxiable A, AAAA, or CNAME records that are not proxied, without returning record content or origin addresses to Tenarie.",
  "status": "active",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/client/v4/zones",
          "query_params": {
            "per_page": 50
          }
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "pagination": {
          "mode": "page_number",
          "page_param": "page",
          "start_page": 1,
          "max_pages": 1,
          "continuation": {
            "enabled": true,
            "max_partitions": 20
          }
        },
        "response_handling": {
          "records_path": "result"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_allowlist": [
            "id",
            "name"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "get_2",
        "step_type": "connector_get",
        "request": {
          "path": "/client/v4/zones/{{ record.id }}/dns_records",
          "query_params": {
            "per_page": 100,
            "proxied": "false"
          }
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "pagination": {
          "mode": "page_number",
          "page_param": "page",
          "start_page": 1,
          "max_pages": 5
        },
        "iteration": {
          "mode": "for_each_record",
          "records_source": "get_1.records",
          "preserved_parent_fields": [
            "id",
            "name"
          ]
        },
        "response_handling": {
          "records_path": "result"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_allowlist": [
            "id",
            "name",
            "type",
            "ttl",
            "proxied",
            "proxiable",
            "modified_on"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_2"
      },
      {
        "step_key": "filter_1",
        "step_type": "filter_rule",
        "input_source": "get_2.records",
        "output_alias": "filter_1",
        "match_policy": "all",
        "rules": [
          {
            "field": "proxiable",
            "operator": "equals",
            "value": true
          },
          {
            "field": "proxied",
            "operator": "equals",
            "value": false
          }
        ]
      },
      {
        "step_key": "filter_2",
        "step_type": "filter_rule",
        "input_source": "filter_1.records",
        "output_alias": "filter_2",
        "match_policy": "any",
        "rules": [
          {
            "field": "type",
            "operator": "equals",
            "value": "A"
          },
          {
            "field": "type",
            "operator": "equals",
            "value": "AAAA"
          },
          {
            "field": "type",
            "operator": "equals",
            "value": "CNAME"
          }
        ]
      },
      {
        "step_key": "route_1",
        "step_type": "destination_task_create",
        "record_source": "filter_2.records",
        "mapping": {
          "task_title_template": "Review unproxied Cloudflare DNS record {{ record.name }}",
          "additional_information_template": "Cloudflare DNS record {{ record.name }} ({{ record.id }}) in zone {{ record.parent_context.name }} is a proxiable {{ record.type }} record with proxying disabled. Confirm whether direct DNS exposure is explicitly required before changing it. TTL: {{ record.ttl|default:'not returned' }}. Last modified: {{ record.modified_on|default:'not returned' }}. The Connector does not store the record content or origin address.",
          "owner_user_id": ""
        }
      }
    ]
  }
}
