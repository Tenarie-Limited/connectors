            },
            "request": {
              "path": "/client/v4/zones",
              "query_params": {
                "per_page": 50
              }
            },
            "response_handling": {
              "records_path": "result"
            },
            "step_key": "get_1",
            "step_type": "connector_get"
          },
          {
