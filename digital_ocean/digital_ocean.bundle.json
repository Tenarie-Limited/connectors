    {
      "definition_json": {
        "connector": {
          "config_id": "",
          "family": ""
        },
        "steps": [
          {
            "auth_reference_id": "__use_default__",
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "mode": "records_contract_v1"
            },
            "output_alias": "get_1",
            "pagination": {
              "max_pages": 5,
              "mode": "page_number",
              "page_param": "page",
              "start_page": 1
            },
            "request": {
              "path": "/v2/firewalls",
              "query_params": {
                "per_page": 100
              }
            },
            "response_handling": {
              "child_records_path": "inbound_rules",
              "preserved_parent_fields": [
                "id",
                "name",
                "status"
              ],
              "records_path": "firewalls"
            },
            "step_key": "get_1",
            "step_type": "connector_get"
          },
          {
            "input_source": "get_1.records",
            "match_policy": "any",
            "output_alias": "filter_1",
            "rules": [
              {
                "field": "sources.addresses",
                "operator": "contains",
                "value": "0.0.0.0/0"
              },
              {
                "field": "sources.addresses",
                "operator": "contains",
                "value": "::/0"
              }
            ],
            "step_key": "filter_1",
            "step_type": "filter_rule"
          },
          {
            "input_source": "filter_1.records",
            "match_policy": "any",
            "output_alias": "filter_2",
            "rules": [
              {
                "field": "ports",
                "operator": "equals",
                "value": "21"
              },
              {
                "field": "ports",
                "operator": "equals",
                "value": "23"
              },
              {
                "field": "ports",
                "operator": "equals",
                "value": "0"
              },
              {
                "field": "ports",
                "operator": "equals",
                "value": "all"
              }
            ],
            "step_key": "filter_2",
            "step_type": "filter_rule"
          },
          {
            "input_source": "filter_2.records",
            "match_policy": "all",
            "output_alias": "filter_3",
            "rules": [
              {
                "field": "protocol",
                "operator": "equals",
                "value": "tcp"
              }
            ],
            "step_key": "filter_3",
            "step_type": "filter_rule"
          },
          {
            "mapping": {
              "additional_information_template": "Firewall {{ record.parent_context.name }} ({{ record.parent_context.id }}) allows public TCP inbound access with exact port value {{ record.ports }} from {{ record.sources.addresses }}. Values 0 and all represent all ports. Review whether this rule is approved and restrict it where required. This check does not evaluate ranges, UDP, host controls, or actual reachability.",
              "owner_user_id": "",
              "task_title_template": "Review DigitalOcean firewall {{ record.parent_context.name }} public TCP ports {{ record.ports }}"
            },
            "record_source": "filter_3.records",
            "step_key": "route_1",
            "step_type": "destination_task_create"
          }
        ],
        "trigger": {
          "mode": "manual"
        }
      },
      "description": "Creates review tasks for public TCP inbound rules with exact port values 21, 23, 0, or all. Ranges and UDP are not evaluated; an empty result is not proof of secure firewall configuration.",
      "key": "insecure_firewall_ports",
      "name": "DigitalOcean Insecure Firewall Ports Check",
      "status": "active"
    },
