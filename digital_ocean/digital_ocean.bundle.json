{
  "auth_references": [
    {
      "auth_mode": "static_bearer",
      "key": "digitalocean_default_token",
      "name": "DigitalOcean Bearer Token",
      "public_config_json": {},
      "secret_backend": "environment",
      "secret_bindings_json": {
        "token": "DIGITAL_OCEAN_TOKEN"
      },
      "status": "active"
    }
  ],
  "connector": {
    "base_url": "https://api.digitalocean.com",
    "config_json": {
      "provider_key": "digital_ocean"
    },
    "default_auth_key": "digitalocean_default_token",
    "description": "Read-only DigitalOcean connector for cloud resource inventory and security review workflows.",
    "family": "custom_api",
    "name": "DigitalOcean Connector",
    "status": "active"
  },
  "package_type": "connector_bundle",
  "schema_version": "connector_bundle.v1",
  "workflows": [
    {
      "definition_json": {
        "connector": {
          "config_id": "",
          "family": ""
        },
        "steps": [
          {
            "auth_reference_id": "__use_default__",
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "field_allowlist": [
                "id",
                "name",
                "engine",
                "version",
                "semantic_version",
                "num_nodes",
                "region",
                "status",
                "size",
                "private_network_uuid",
                "storage_size_mib",
                "created_at"
              ],
              "mode": "records_contract_v1"
            },
            "output_alias": "get_1",
            "request": {
              "path": "/v2/databases",
              "query_params": {}
            },
            "response_handling": {
              "records_path": "databases"
            },
            "step_key": "get_1",
            "step_type": "connector_get"
          },
          {
            "input_source": "get_1.records",
            "match_policy": "all",
            "output_alias": "filter_1",
            "rules": [
              {
                "field": "status",
                "operator": "equals",
                "value": "online"
              }
            ],
            "step_key": "filter_1",
            "step_type": "filter_rule"
          },
          {
            "mapping": {
              "asset_type": "infrastructure",
              "description_template": "DigitalOcean managed {{ record.engine|default:'database' }} cluster {{ record.name }} ({{ record.id }}).",
              "external_id_template": "{{ record.id }}",
              "external_system": "digital_ocean",
              "notes_template": "Provider status: {{ record.status|default:'unknown' }}. Engine version: {{ record.semantic_version|default:record.version|default:'not returned' }}. Region: {{ record.region|default:'not returned' }}. Size: {{ record.size|default:'not returned' }}. Nodes: {{ record.num_nodes|default:'not returned' }}. Storage MiB: {{ record.storage_size_mib|default:'not returned' }}. Private network: {{ record.private_network_uuid|default:'not returned' }}. Created: {{ record.created_at|default:'not returned' }}.",
              "owner_user_id": "",
              "title_template": "DigitalOcean Database {{ record.name }}"
            },
            "record_source": "filter_1.records",
            "step_key": "route_1",
            "step_type": "destination_asset_create"
          }
        ],
        "trigger": {
          "mode": "manual"
        }
      },
      "description": "Creates or reuses one Tenarie Asset for each online DigitalOcean managed database cluster while excluding connection material from worker output.",
      "name": "DigitalOcean Database Inventory",
      "status": "active"
    },
    {
      "definition_json": {
        "connector": {
          "config_id": "",
          "family": ""
        },
        "steps": [
          {
            "auth_reference_id": "__use_default__",
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "field_allowlist": [
                "id",
                "name"
              ],
              "mode": "records_contract_v1"
            },
            "output_alias": "get_1",
            "request": {
              "path": "/v2/databases",
              "query_params": {}
            },
            "response_handling": {
              "records_path": "databases"
            },
            "step_key": "get_1",
            "step_type": "connector_get"
          },
          {
            "auth_reference_id": "__use_default__",
            "iteration": {
              "mode": "for_each_record",
              "records_source": "get_1.records"
            },
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "field_allowlist": [
                "uuid",
                "cluster_uuid",
                "type",
                "value",
                "description",
                "created_at"
              ],
              "mode": "records_contract_v1"
            },
            "output_alias": "get_2",
            "request": {
              "path": "/v2/databases/{{ record.id }}/firewall",
              "query_params": {}
            },
            "response_handling": {
              "records_path": "rules"
            },
            "step_key": "get_2",
            "step_type": "connector_get"
          },
          {
            "input_source": "get_2.records",
            "match_policy": "all",
            "output_alias": "filter_1",
            "rules": [
              {
                "field": "type",
                "operator": "equals",
                "value": "ip_addr"
              }
            ],
            "step_key": "filter_1",
            "step_type": "filter_rule"
          },
          {
            "input_source": "filter_1.records",
            "match_policy": "any",
            "output_alias": "filter_2",
            "rules": [
              {
                "field": "value",
                "operator": "equals",
                "value": "0.0.0.0/0"
              },
              {
                "field": "value",
                "operator": "equals",
                "value": "::/0"
              }
            ],
            "step_key": "filter_2",
            "step_type": "filter_rule"
          },
          {
            "mapping": {
              "additional_information_template": "Database cluster {{ record.cluster_uuid }} has trusted-source rule {{ record.uuid }} allowing {{ record.value }}. Review the rule and replace unrestricted public access with the narrowest approved Droplet, Kubernetes, application, tag, or IP source.",
              "owner_user_id": "",
              "task_title_template": "DigitalOcean database {{ record.cluster_uuid }} permits public trusted source {{ record.value }}"
            },
            "record_source": "filter_2.records",
            "step_key": "route_1",
            "step_type": "destination_task_create"
          }
        ],
        "trigger": {
          "mode": "manual"
        }
      },
      "description": "Creates tasks when a DigitalOcean managed database trusted-source rule allows all public IPv4 or IPv6 addresses.",
      "name": "DigitalOcean Database Public Trusted Sources Check",
      "status": "active"
    },
