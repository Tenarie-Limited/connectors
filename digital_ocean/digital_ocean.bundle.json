            "step_key": "filter_3",
            "step_type": "filter_rule"
          },
          {
            "mapping": {
              "additional_information_template": "DigitalOcean Load Balancer {{ record.parent_context.name }} ({{ record.parent_context.id }}) listens on HTTP port 80 and has the provider HTTP-to-HTTPS redirect disabled. Confirm whether plaintext HTTP is explicitly required. If not, configure a supported HTTPS or HTTP/2 listener and enable the redirect. Backend target: {{ record.target_protocol }} port {{ record.target_port }}. This is an advisory review and does not prove a vulnerability by itself.",
              "owner_user_id": "",
              "task_title_template": "Review HTTP redirect for DigitalOcean Load Balancer {{ record.parent_context.name }}"
            },
            "record_source": "filter_3.records",
            "step_key": "route_1",
            "step_type": "destination_task_create"
