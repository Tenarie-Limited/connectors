  "workflows": [
    {
      "definition_json": {
        "connector": {
          "config_id": "",
          "family": ""
        },
        "steps": [
          {
            "auth_reference_id": "__use_default__",
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "field_allowlist": [
                "id",
                "name",
                "engine",
                "version",
                "semantic_version",
                "num_nodes",
                "region",
                "status",
                "size",
                "private_network_uuid",
                "storage_size_mib",
                "created_at"
              ],
              "mode": "records_contract_v1"
            },
            "output_alias": "get_1",
            "request": {
              "path": "/v2/databases",
              "query_params": {}
            },
            "response_handling": {
              "records_path": "databases"
            },
            "step_key": "get_1",
            "step_type": "connector_get"
          },
          {
            "mapping": {
              "asset_type": "infrastructure",
              "description_template": "DigitalOcean managed {{ record.engine|default:'database' }} cluster {{ record.name }} ({{ record.id }}).",
              "external_id_template": "{{ record.id }}",
              "external_system": "digital_ocean",
              "notes_template": "Provider status: {{ record.status|default:'unknown' }}. Engine version: {% if record.semantic_version %}{{ record.semantic_version }}{% else %}{{ record.version|default:'not returned' }}{% endif %}. Region: {{ record.region|default:'not returned' }}. Size: {{ record.size|default:'not returned' }}. Nodes: {% if record.num_nodes == None or record.num_nodes == '' %}not returned{% else %}{{ record.num_nodes }}{% endif %}. Storage MiB: {% if record.storage_size_mib == None or record.storage_size_mib == '' %}not returned{% else %}{{ record.storage_size_mib }}{% endif %}. Private network: {{ record.private_network_uuid|default:'not returned' }}. Created: {{ record.created_at|default:'not returned' }}.",
              "owner_user_id": "",
              "title_template": "DigitalOcean Database {{ record.name }}"
            },
            "record_source": "get_1.records",
            "step_key": "route_1",
            "step_type": "destination_asset_create"
          }
        ],
        "trigger": {
          "mode": "manual"
        }
      },
      "description": "Creates or updates an asset for each DigitalOcean managed database cluster, including clusters that are not currently active.",
      "key": "database_inventory",
      "name": "DigitalOcean Database Inventory",
      "status": "active"
    },
    {
      "definition_json": {
        "connector": {
          "config_id": "",
          "family": ""
        },
        "steps": [
          {
            "auth_reference_id": "__use_default__",
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "field_allowlist": [
                "id",
                "name"
              ],
              "field_mappings": [
                {
                  "output_field": "id",
                  "source_path": "id"
                }
              ],
              "mode": "records_contract_v1"
            },
            "output_alias": "get_1",
            "request": {
              "path": "/v2/databases",
              "query_params": {}
            },
            "response_handling": {
              "records_path": "databases"
            },
            "step_key": "get_1",
            "step_type": "connector_get"
          },
          {
            "auth_reference_id": "__use_default__",
            "iteration": {
              "mode": "for_each_record",
              "preserved_parent_fields": [
                "id",
                "name"
              ],
              "records_source": "get_1.records"
            },
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "field_allowlist": [
                "type",
                "value"
              ],
              "field_mappings": [
                {
                  "output_field": "type",
                  "source_path": "type"
                },
                {
                  "output_field": "value",
                  "source_path": "value"
                }
              ],
              "mode": "records_contract_v1"
            },
            "output_alias": "get_2",
            "request": {
              "path": "/v2/databases/{{ record.id }}/firewall",
              "query_params": {}
            },
            "response_handling": {
              "records_path": "rules"
            },
            "step_key": "get_2",
            "step_type": "connector_get"
          },
          {
            "input_source": "get_2.records",
            "match_policy": "all",
            "output_alias": "filter_1",
            "rules": [
              {
                "field": "type",
                "operator": "equals",
                "value": "ip_addr"
              }
            ],
            "step_key": "filter_1",
            "step_type": "filter_rule"
          },
          {
            "input_source": "filter_1.records",
            "match_policy": "any",
            "output_alias": "filter_2",
            "rules": [
              {
                "field": "value",
                "operator": "equals",
                "value": "0.0.0.0/0"
              },
              {
                "field": "value",
                "operator": "equals",
                "value": "::/0"
              }
            ],
            "step_key": "filter_2",
            "step_type": "filter_rule"
          },
          {
            "mapping": {
              "control_test_alias": "database_public_source_restriction_result",
              "control_test_code": "T-65",
              "control_test_id": "00000000-0000-0000-0000-000000000000",
              "data_source_label": "DigitalOcean explicit unrestricted database IP rules",
              "evaluation_mode": "fail_when_records_present",
              "notes": "This review identifies rules containing exactly 0.0.0.0/0 or ::/0. It does not assess combined address ranges, equivalent representations, default access, or actual network reachability. Keep it in draft until the intended databases are confirmed and missing or unknown access rules can be handled reliably."
            },
            "record_source": "filter_2.records",
            "step_key": "result_1",
            "step_type": "destination_control_test_result_add"
          }
        ],
        "trigger": {
          "mode": "manual"
        }
      },
      "description": "Checks DigitalOcean managed database access rules for explicit unrestricted IPv4 or IPv6 sources.",
      "key": "database_public_source_restriction_result",
      "name": "DigitalOcean Explicit Public Database Rule Result",
      "status": "draft"
