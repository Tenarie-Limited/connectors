{
  "name": "DigitalOcean Explicit Public Database Rule Result",
  "description": "Checks DigitalOcean managed database access rules for explicit unrestricted IPv4 or IPv6 sources.",
  "status": "draft",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/v2/databases",
          "query_params": {}
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "response_handling": {
          "records_path": "databases"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_allowlist": [
            "id",
            "name"
          ],
          "field_mappings": [
            {
              "output_field": "id",
              "source_path": "id"
            }
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "get_2",
        "step_type": "connector_get",
        "request": {
          "path": "/v2/databases/{{ record.id }}/firewall",
          "query_params": {}
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "iteration": {
          "mode": "for_each_record",
          "records_source": "get_1.records",
          "preserved_parent_fields": [
            "id",
            "name"
          ]
        },
        "response_handling": {
          "records_path": "rules"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_mappings": [
            {
              "output_field": "type",
              "source_path": "type"
            },
            {
              "output_field": "value",
              "source_path": "value"
            }
          ],
          "field_allowlist": [
            "type",
            "value"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_2"
      },
      {
        "step_key": "filter_1",
        "step_type": "filter_rule",
        "input_source": "get_2.records",
        "output_alias": "filter_1",
        "match_policy": "all",
        "rules": [
          {
            "field": "type",
            "operator": "equals",
            "value": "ip_addr"
          }
        ]
      },
      {
        "step_key": "filter_2",
        "step_type": "filter_rule",
        "input_source": "filter_1.records",
        "output_alias": "filter_2",
        "match_policy": "any",
        "rules": [
          {
            "field": "value",
            "operator": "equals",
            "value": "0.0.0.0/0"
          },
          {
            "field": "value",
            "operator": "equals",
            "value": "::/0"
          }
        ]
      },
      {
        "step_key": "result_1",
        "step_type": "destination_control_test_result_add",
        "record_source": "filter_2.records",
        "mapping": {
          "control_test_alias": "database_public_source_restriction_result",
          "control_test_id": "00000000-0000-0000-0000-000000000000",
          "control_test_code": "T-65",
          "evaluation_mode": "fail_when_records_present",
          "data_source_label": "DigitalOcean explicit unrestricted database IP rules",
          "notes": "This review identifies rules containing exactly 0.0.0.0/0 or ::/0. It does not assess combined address ranges, equivalent representations, default access, or actual network reachability. Keep it in draft until the intended databases are confirmed and missing or unknown access rules can be handled reliably."
        }
      }
    ]
  }
}
