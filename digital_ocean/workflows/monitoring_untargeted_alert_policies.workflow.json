{
  "name": "DigitalOcean Untargeted Alert Policies Check",
  "description": "Creates tasks for DigitalOcean Monitoring alert policies that have neither entity nor tag targets.",
  "status": "active",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/v2/monitoring/alerts",
          "query_params": {
            "per_page": 100
          }
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "pagination": {
          "mode": "page_number",
          "page_param": "page",
          "start_page": 1,
          "max_pages": 5
        },
        "response_handling": {
          "records_path": "policies"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_allowlist": [
            "uuid",
            "description",
            "enabled",
            "type",
            "entities",
            "tags"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "filter_1",
        "step_type": "filter_rule",
        "input_source": "get_1.records",
        "output_alias": "filter_1",
        "match_policy": "all",
        "rules": [
          {
            "field": "entities",
            "operator": "not_exists"
          }
        ]
      },
      {
        "step_key": "filter_2",
        "step_type": "filter_rule",
        "input_source": "filter_1.records",
        "output_alias": "filter_2",
        "match_policy": "all",
        "rules": [
          {
            "field": "tags",
            "operator": "not_exists"
          }
        ]
      },
      {
        "step_key": "route_1",
        "step_type": "destination_task_create",
        "record_source": "filter_2.records",
        "mapping": {
          "task_title_template": "Assign targets to DigitalOcean alert policy {{ record.description }}",
          "additional_information_template": "DigitalOcean Monitoring alert policy {{ record.description }} ({{ record.uuid }}) has no entity or tag targets. Assign the intended resources or formally retire the obsolete policy. Policy type: {{ record.type }}. Enabled: {{ record.enabled }}.",
          "owner_user_id": ""
        }
      }
    ]
  }
}
