{
  "name": "DigitalOcean Firewall Inventory",
  "description": "Creates or reuses one Tenarie Asset for each DigitalOcean Cloud Firewall returned by the account.",
  "status": "active",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/v2/firewalls",
          "query_params": {
            "per_page": 100
          }
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "pagination": {
          "mode": "page_number",
          "page_param": "page",
          "start_page": 1,
          "max_pages": 5
        },
        "response_handling": {
          "records_path": "firewalls"
        },
        "normalization": {
          "mode": "records_contract_v1"
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "route_1",
        "step_type": "destination_asset_create",
        "record_source": "get_1.records",
        "mapping": {
          "external_system": "digital_ocean",
          "external_id_template": "{{ record.id }}",
          "title_template": "DigitalOcean firewall {{ record.name }}",
          "asset_type": "infrastructure",
          "description_template": "DigitalOcean Cloud Firewall {{ record.name }} ({{ record.id }}).",
          "notes_template": "Provider status: {{ record.status|default:'unknown' }}. Attached Droplets: {{ record.droplet_ids|default:'none returned' }}. Pending changes: {{ record.pending_changes|default:'none returned' }}.",
          "owner_user_id": ""
        }
      }
    ]
  }
}
