{
  "name": "DigitalOcean Load Balancer HTTP Redirect Review",
  "description": "Creates advisory tasks when a DigitalOcean Load Balancer listens on HTTP port 80 without enabling the provider HTTP-to-HTTPS redirect.",
  "status": "active",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/v2/load_balancers",
          "query_params": {
            "per_page": 100
          }
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "pagination": {
          "mode": "page_number",
          "page_param": "page",
          "start_page": 1,
          "max_pages": 5
        },
        "response_handling": {
          "records_path": "load_balancers",
          "child_records_path": "forwarding_rules",
          "preserved_parent_fields": [
            "id",
            "name",
            "status",
            "type",
            "network",
            "redirect_http_to_https"
          ]
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_allowlist": [
            "entry_protocol",
            "entry_port",
            "target_protocol",
            "target_port",
            "tls_passthrough",
            "parent_context"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "filter_1",
        "step_type": "filter_rule",
        "input_source": "get_1.records",
        "output_alias": "filter_1",
        "match_policy": "all",
        "rules": [
          {
            "field": "entry_protocol",
            "operator": "equals",
            "value": "http"
          }
        ]
      },
      {
        "step_key": "filter_2",
        "step_type": "filter_rule",
        "input_source": "filter_1.records",
        "output_alias": "filter_2",
        "match_policy": "all",
        "rules": [
          {
            "field": "entry_port",
            "operator": "equals",
            "value": 80
          }
        ]
      },
      {
        "step_key": "filter_3",
        "step_type": "filter_rule",
        "input_source": "filter_2.records",
        "output_alias": "filter_3",
        "match_policy": "all",
        "rules": [
          {
            "field": "parent_context.redirect_http_to_https",
            "operator": "equals",
            "value": false
          }
        ]
      },
      {
        "step_key": "route_1",
        "step_type": "destination_task_create",
        "record_source": "filter_3.records",
        "mapping": {
          "task_title_template": "Review HTTP redirect for DigitalOcean Load Balancer {{ record.parent_context.name }}",
          "additional_information_template": "DigitalOcean Load Balancer {{ record.parent_context.name }} ({{ record.parent_context.id }}) listens on HTTP port 80 and has the provider HTTP-to-HTTPS redirect disabled. Confirm whether plaintext HTTP is explicitly required. If not, configure a supported HTTPS or HTTP/2 listener and enable the redirect. Backend target: {{ record.target_protocol }} port {{ record.target_port }}. This is an advisory review and does not prove a vulnerability by itself.",
          "owner_user_id": ""
        }
      }
    ]
  }
}
