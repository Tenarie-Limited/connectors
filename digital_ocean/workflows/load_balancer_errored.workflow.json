{
  "name": "DigitalOcean Errored Load Balancers Check",
  "description": "Creates tasks for DigitalOcean Load Balancers whose provider status is errored.",
  "status": "active",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/v2/load_balancers",
          "query_params": {
            "per_page": 100
          }
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "pagination": {
          "mode": "page_number",
          "page_param": "page",
          "start_page": 1,
          "max_pages": 5
        },
        "response_handling": {
          "records_path": "load_balancers"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_allowlist": [
            "id",
            "name",
            "status",
            "type"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "filter_1",
        "step_type": "filter_rule",
        "input_source": "get_1.records",
        "output_alias": "filter_1",
        "match_policy": "all",
        "rules": [
          {
            "field": "status",
            "operator": "equals",
            "value": "errored"
          }
        ]
      },
      {
        "step_key": "route_1",
        "step_type": "destination_task_create",
        "record_source": "filter_1.records",
        "mapping": {
          "task_title_template": "Investigate errored DigitalOcean Load Balancer {{ record.name }}",
          "additional_information_template": "DigitalOcean reports Load Balancer {{ record.name }} ({{ record.id }}) in the errored state. Review its provider events, forwarding configuration, targets, and health checks. Load Balancer type: {{ record.type|default:'not returned' }}.",
          "owner_user_id": ""
        }
      }
    ]
  }
}
