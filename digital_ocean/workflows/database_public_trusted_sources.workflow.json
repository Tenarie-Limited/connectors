{
  "name": "DigitalOcean Database Public Trusted Sources Check",
  "description": "Creates tasks when a DigitalOcean managed database trusted-source rule allows all public IPv4 or IPv6 addresses.",
  "status": "active",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/v2/databases",
          "query_params": {}
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "response_handling": {
          "records_path": "databases"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_allowlist": [
            "id",
            "name"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "get_2",
        "step_type": "connector_get",
        "request": {
          "path": "/v2/databases/{{ record.id }}/firewall",
          "query_params": {}
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "iteration": {
          "mode": "for_each_record",
          "records_source": "get_1.records"
        },
        "response_handling": {
          "records_path": "rules"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_allowlist": [
            "uuid",
            "cluster_uuid",
            "type",
            "value",
            "description",
            "created_at"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_2"
      },
      {
        "step_key": "filter_1",
        "step_type": "filter_rule",
        "input_source": "get_2.records",
        "output_alias": "filter_1",
        "match_policy": "all",
        "rules": [
          {
            "field": "type",
            "operator": "equals",
            "value": "ip_addr"
          }
        ]
      },
      {
        "step_key": "filter_2",
        "step_type": "filter_rule",
        "input_source": "filter_1.records",
        "output_alias": "filter_2",
        "match_policy": "any",
        "rules": [
          {
            "field": "value",
            "operator": "equals",
            "value": "0.0.0.0/0"
          },
          {
            "field": "value",
            "operator": "equals",
            "value": "::/0"
          }
        ]
      },
      {
        "step_key": "route_1",
        "step_type": "destination_task_create",
        "record_source": "filter_2.records",
        "mapping": {
          "task_title_template": "DigitalOcean database {{ record.cluster_uuid }} permits public trusted source {{ record.value }}",
          "additional_information_template": "Database cluster {{ record.cluster_uuid }} has trusted-source rule {{ record.uuid }} allowing {{ record.value }}. Review the rule and replace unrestricted public access with the narrowest approved Droplet, Kubernetes, application, tag, or IP source.",
          "owner_user_id": ""
        }
      }
    ]
  }
}
