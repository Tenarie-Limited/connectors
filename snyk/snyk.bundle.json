{
  "auth_references": [
    {
      "auth_mode": "static_header",
      "key": "snyk_default_token",
      "name": "Snyk API Token",
      "public_config_json": {
        "header_name": "Authorization"
      },
      "secret_backend": "environment",
      "secret_bindings_json": {
        "secret": "SNYK_API_TOKEN"
      },
      "status": "active"
    }
  ],
  "connector": {
    "base_url": "https://api.snyk.io/rest",
    "config_json": {
      "headers": {
        "Accept": "application/vnd.api+json"
      },
      "provider_key": "snyk"
    },
    "default_auth_key": "snyk_default_token",
    "description": "Read-only Snyk connector for Target and Project inventory plus synchronous open-Issue ingestion.",
    "family": "custom_api",
    "name": "Snyk Connector",
    "status": "active"
  },
  "package_key": "snyk",
  "package_type": "connector_bundle",
  "release": "2026.09.4",
  "schema_version": "connector_bundle.v1",
  "workflows": [
    {
      "definition_json": {
        "connector": {
          "config_id": "",
          "family": ""
        },
        "steps": [
          {
            "auth_reference_id": "__use_default__",
            "limits": {
              "max_response_bytes": 1048576,
              "timeout_seconds": 30
            },
            "normalization": {
              "field_allowlist": [
                "id",
                "severity",
                "provider_status",
                "issue_type",
                "scan_item_id",
                "ignored"
              ],
              "field_coercions": [
                {
                  "coerce_to": "boolean",
                  "field": "ignored"
                }
              ],
              "field_mappings": [
                {
                  "output_field": "id",
                  "source_path": "id"
                },
                {
                  "output_field": "severity",
                  "source_path": "attributes.effective_severity_level"
                },
                {
                  "output_field": "provider_status",
                  "source_path": "attributes.status"
                },
                {
                  "output_field": "issue_type",
                  "source_path": "attributes.type"
                },
                {
                  "output_field": "scan_item_id",
                  "source_path": "relationships.scan_item.data.id"
                },
                {
                  "output_field": "ignored",
                  "source_path": "attributes.ignored"
                }
              ],
              "mode": "records_contract_v1"
            },
            "output_alias": "get_1",
            "pagination": {
              "max_pages": 5,
              "mode": "next_link",
              "next_link_path": "links.next"
            },
            "request": {
              "path": "/orgs/REPLACE_WITH_SNYK_ORGANIZATION_ID/issues",
              "query_params": {
                "limit": 100,
                "status": "open",
                "version": "2024-10-15"
              }
            },
            "response_handling": {
              "records_path": "data"
            },
            "step_key": "get_1",
            "step_type": "connector_get"
          },
          {
            "input_source": "get_1.records",
            "match_policy": "any",
            "output_alias": "filter_1",
            "rules": [
              {
                "field": "issue_type",
                "operator": "equals",
                "value": "package_vulnerability"
              },
              {
                "field": "issue_type",
                "operator": "equals",
                "value": "code"
              }
            ],
            "step_key": "filter_1",
            "step_type": "filter_rule"
          },
          {
            "input_source": "filter_1.records",
            "match_policy": "any",
            "output_alias": "filter_2",
            "rules": [
              {
                "field": "severity",
                "operator": "equals",
                "value": "high"
              },
              {
                "field": "severity",
                "operator": "equals",
                "value": "critical"
              }
            ],
            "step_key": "filter_2",
            "step_type": "filter_rule"
          },
          {
            "input_source": "filter_2.records",
            "match_policy": "all",
            "output_alias": "filter_3",
            "rules": [
              {
                "field": "provider_status",
                "operator": "equals",
                "value": "open"
              }
            ],
            "step_key": "filter_3",
            "step_type": "filter_rule"
          },
          {
            "mapping": {
              "control_test_alias": "application_finding_threshold_result",
              "control_test_code": "T-68",
              "control_test_id": "00000000-0000-0000-0000-000000000000",
              "data_source_label": "Snyk Application Finding Threshold Result",
              "evaluation_mode": "fail_when_records_present",
              "notes": "Confirm the included applications, severity classifications, and approved exemptions before enabling this workflow. Keep it in draft until missing applications and unknown severity values can be handled reliably. Ignored findings are included; ignoring a finding does not make it an approved exemption."
            },
            "record_source": "filter_3.records",
            "step_key": "result_1",
            "step_type": "destination_control_test_result_add"
          }
        ],
        "trigger": {
          "mode": "manual"
        }
      },
      "description": "Reviews Snyk application findings for high or critical severity issues.",
      "key": "application_finding_threshold_result",
      "name": "Snyk Application Finding Threshold Result",
      "status": "draft"
    },
