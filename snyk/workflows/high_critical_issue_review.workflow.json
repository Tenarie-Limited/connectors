{
  "name": "Snyk High and Critical Issue Review",
  "description": "Creates review Tasks for open, non-ignored high or critical package_vulnerability and code Issues. Other issue types are outside this draft workflow; this is not a remediation SLA test.",
  "status": "draft",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/orgs/REPLACE_WITH_SNYK_ORGANIZATION_ID/issues",
          "query_params": {
            "version": "2024-10-15",
            "limit": 100,
            "status": "open",
            "ignored": false
          }
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "pagination": {
          "mode": "next_link",
          "next_link_path": "links.next",
          "max_pages": 5
        },
        "response_handling": {
          "records_path": "data"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_mappings": [
            {
              "output_field": "title",
              "source_path": "attributes.title"
            },
            {
              "output_field": "description",
              "source_path": "attributes.description"
            },
            {
              "output_field": "severity",
              "source_path": "attributes.effective_severity_level"
            },
            {
              "output_field": "provider_status",
              "source_path": "attributes.status"
            },
            {
              "output_field": "issue_type",
              "source_path": "attributes.type"
            },
            {
              "output_field": "scan_item_id",
              "source_path": "relationships.scan_item.data.id"
            },
            {
              "output_field": "external_id",
              "source_path": "id"
            },
            {
              "output_field": "ignored",
              "source_path": "attributes.ignored"
            }
          ],
          "field_allowlist": [
            "id",
            "title",
            "description",
            "severity",
            "provider_status",
            "issue_type",
            "scan_item_id",
            "external_id",
            "ignored"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "filter_1",
        "step_type": "filter_rule",
        "input_source": "get_1.records",
        "output_alias": "filter_1",
        "match_policy": "any",
        "rules": [
          {
            "field": "issue_type",
            "operator": "equals",
            "value": "package_vulnerability"
          },
          {
            "field": "issue_type",
            "operator": "equals",
            "value": "code"
          }
        ]
      },
      {
        "step_key": "filter_2",
        "step_type": "filter_rule",
        "input_source": "filter_1.records",
        "output_alias": "filter_2",
        "match_policy": "any",
        "rules": [
          {
            "field": "severity",
            "operator": "equals",
            "value": "high"
          },
          {
            "field": "severity",
            "operator": "equals",
            "value": "critical"
          }
        ]
      },
      {
        "step_key": "filter_3",
        "step_type": "filter_rule",
        "input_source": "filter_2.records",
        "output_alias": "filter_3",
        "match_policy": "all",
        "rules": [
          {
            "field": "provider_status",
            "operator": "equals",
            "value": "open"
          },
          {
            "field": "ignored",
            "operator": "equals",
            "value": false
          },
          {
            "field": "external_id",
            "operator": "exists",
            "value": true
          }
        ]
      },
      {
        "step_key": "route_1",
        "step_type": "destination_task_create",
        "record_source": "filter_3.records",
        "mapping": {
          "task_title_template": "Review Snyk {{ record.severity }} issue: {{ record.title }}",
          "additional_information_template": "Snyk issue {{ record.id }} of type {{ record.issue_type }} reports severity {{ record.severity }} on scan item {{ record.scan_item_id }}. Review the current issue and approved fix in Snyk, prioritize it under your remediation policy, and validate the fix. Provider status and severity do not establish a remediation SLA result. Existing Tasks are reused without reopening or updating.",
          "owner_user_id": ""
        }
      }
    ]
  }
}
