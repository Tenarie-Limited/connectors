{
  "name": "SentinelOne Eligible Agent Active Result",
  "description": "Reviews whether the selected SentinelOne agents are reported as active.",
  "status": "draft",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/web/api/v2.1/agents",
          "query_params": {}
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "pagination": {
          "mode": "offset_limit",
          "offset_param": "skip",
          "limit_param": "limit",
          "start_offset": 0,
          "omit_initial_offset": true,
          "page_size": 100,
          "max_pages": 5
        },
        "response_handling": {
          "records_path": "data"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_mappings": [
            {
              "output_field": "is_active",
              "source_path": "isActive"
            },
            {
              "output_field": "is_uninstalled",
              "source_path": "isUninstalled"
            },
            {
              "output_field": "is_decommissioned",
              "source_path": "isDecommissioned"
            },
            {
              "output_field": "is_pending_uninstall",
              "source_path": "isPendingUninstall"
            },
            {
              "output_field": "id",
              "source_path": "id"
            }
          ],
          "field_coercions": [
            {
              "field": "is_active",
              "coerce_to": "boolean"
            },
            {
              "field": "is_uninstalled",
              "coerce_to": "boolean"
            },
            {
              "field": "is_decommissioned",
              "coerce_to": "boolean"
            },
            {
              "field": "is_pending_uninstall",
              "coerce_to": "boolean"
            }
          ],
          "field_allowlist": [
            "is_active",
            "is_uninstalled",
            "is_decommissioned",
            "is_pending_uninstall",
            "id"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "filter_1",
        "step_type": "filter_rule",
        "input_source": "get_1.records",
        "output_alias": "filter_1",
        "match_policy": "all",
        "rules": [
          {
            "field": "is_active",
            "operator": "equals",
            "value": false
          },
          {
            "field": "is_uninstalled",
            "operator": "equals",
            "value": false
          },
          {
            "field": "is_decommissioned",
            "operator": "equals",
            "value": false
          },
          {
            "field": "is_pending_uninstall",
            "operator": "equals",
            "value": false
          }
        ]
      },
      {
        "step_key": "result_1",
        "step_type": "destination_control_test_result_add",
        "record_source": "filter_1.records",
        "mapping": {
          "control_test_alias": "eligible_agent_active_result",
          "control_test_id": "00000000-0000-0000-0000-000000000000",
          "control_test_code": "T-66",
          "evaluation_mode": "fail_when_records_present",
          "data_source_label": "SentinelOne Eligible Agent Active Result",
          "notes": "Confirm which agents are required to be monitored before enabling this workflow. Keep it in draft until the agent list is complete and each agent can be identified reliably. An empty agent list does not establish that all required agents are active."
        }
      }
    ]
  }
}
