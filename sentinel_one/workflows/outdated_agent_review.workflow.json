{
  "name": "SentinelOne Outdated Agent Review",
  "description": "Creates review Tasks for installed, non-decommissioned agents that reports not up to date, excluding pending uninstall. This is a provider flag observation, not an elapsed-time or protection test.",
  "status": "draft",
  "definition_json": {
    "trigger": {
      "mode": "manual"
    },
    "connector": {
      "family": "",
      "config_id": ""
    },
    "steps": [
      {
        "step_key": "get_1",
        "step_type": "connector_get",
        "request": {
          "path": "/web/api/v2.1/agents",
          "query_params": {}
        },
        "limits": {
          "timeout_seconds": 30,
          "max_response_bytes": 1048576
        },
        "pagination": {
          "mode": "offset_limit",
          "offset_param": "skip",
          "limit_param": "limit",
          "start_offset": 0,
          "omit_initial_offset": true,
          "page_size": 100,
          "max_pages": 5
        },
        "response_handling": {
          "records_path": "data"
        },
        "normalization": {
          "mode": "records_contract_v1",
          "field_mappings": [
            {
              "output_field": "computer_name",
              "source_path": "computerName"
            },
            {
              "output_field": "agent_version",
              "source_path": "agentVersion"
            },
            {
              "output_field": "os_name",
              "source_path": "osName"
            },
            {
              "output_field": "os_arch",
              "source_path": "osArch"
            },
            {
              "output_field": "site_name",
              "source_path": "siteName"
            },
            {
              "output_field": "group_name",
              "source_path": "groupName"
            },
            {
              "output_field": "registered_at",
              "source_path": "registeredAt"
            },
            {
              "output_field": "last_active_date",
              "source_path": "lastActiveDate"
            },
            {
              "output_field": "is_active",
              "source_path": "isActive"
            },
            {
              "output_field": "is_up_to_date",
              "source_path": "isUpToDate"
            },
            {
              "output_field": "network_status",
              "source_path": "networkStatus"
            },
            {
              "output_field": "is_pending_uninstall",
              "source_path": "isPendingUninstall"
            },
            {
              "output_field": "is_uninstalled",
              "source_path": "isUninstalled"
            },
            {
              "output_field": "is_decommissioned",
              "source_path": "isDecommissioned"
            },
            {
              "output_field": "active_protection",
              "source_path": "activeProtection"
            },
            {
              "output_field": "external_id",
              "source_path": "id"
            }
          ],
          "field_allowlist": [
            "id",
            "computer_name",
            "agent_version",
            "os_name",
            "os_arch",
            "site_name",
            "group_name",
            "registered_at",
            "last_active_date",
            "is_active",
            "is_up_to_date",
            "network_status",
            "is_pending_uninstall",
            "is_uninstalled",
            "is_decommissioned",
            "active_protection",
            "external_id"
          ]
        },
        "auth_reference_id": "__use_default__",
        "output_alias": "get_1"
      },
      {
        "step_key": "filter_1",
        "step_type": "filter_rule",
        "input_source": "get_1.records",
        "output_alias": "filter_1",
        "match_policy": "all",
        "rules": [
          {
            "field": "is_up_to_date",
            "operator": "equals",
            "value": false
          },
          {
            "field": "is_uninstalled",
            "operator": "equals",
            "value": false
          },
          {
            "field": "is_decommissioned",
            "operator": "equals",
            "value": false
          },
          {
            "field": "is_pending_uninstall",
            "operator": "equals",
            "value": false
          },
          {
            "field": "external_id",
            "operator": "exists",
            "value": true
          }
        ]
      },
      {
        "step_key": "route_1",
        "step_type": "destination_task_create",
        "record_source": "filter_1.records",
        "mapping": {
          "task_title_template": "SentinelOne Outdated Agent Review: {{ record.computer_name }}",
          "additional_information_template": "SentinelOne agent {{ record.id }} ({{ record.computer_name }}) reports not up to date. Site: {{ record.site_name }}. Group: {{ record.group_name }}. Version: {{ record.agent_version }}. Last active reported by provider: {{ record.last_active_date }}. Confirm the expected device state and investigate in SentinelOne. This observation establishes neither a time-based SLA breach nor protection effectiveness. Existing Tasks are reused without reopening or updating.",
          "owner_user_id": ""
        }
      }
    ]
  }
}
